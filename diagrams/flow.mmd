flowchart LR
    R1["Request 1"] -->|"input"| Batcher["📬 Batcher"]
    R2["Request 2"] -->|"input"| Batcher
    R3["Request 3"] -->|"input"| Batcher
    
    subgraph INSIDE["ort-superserve"]
        direction LR
        
        subgraph P["⚡ Preprocess"]
            P1["Worker 1"]
            P2["Worker 2"]
            P3["..."]
            P1 ~~~ P2 ~~~ P3
        end
        
        subgraph S["🔥 Session Pool"]
            S1["Session 1"]
            S2["Session 2"]
            S3["..."]
            S1 ~~~ S2 ~~~ S3
        end
        
        subgraph PP["⚡ Postprocess"]
            PP1["Worker 1"]
            PP2["Worker 2"]
            PP3["..."]
            PP1 ~~~ PP2 ~~~ PP3
        end
        
        Batcher -->|"batch"| P
        P -->|"matrix"| S
        S -->|"slice"| PP
    end
    
    PP -->|"output"| O1["Response 1"]
    PP -->|"output"| O2["Response 2"]
    PP -->|"output"| O3["Response 3"]
    
    style INSIDE fill:#f5f5f5,stroke:#333,stroke-width:2px
    style Batcher fill:#fff3e0
    style P fill:#e8f5e9
    style S fill:#fce4ec
    style PP fill:#e8f5e9
    style R1 fill:#e3f2fd
    style R2 fill:#e3f2fd
    style R3 fill:#e3f2fd
    style O1 fill:#e3f2fd
    style O2 fill:#e3f2fd
    style O3 fill:#e3f2fd