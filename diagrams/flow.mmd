flowchart LR
    Requests["📥 Requests"] -->|"mpsc channel"| Batcher["📬 Batcher"]
    
    subgraph INSIDE["ort-superserve"]
        direction LR
        
        subgraph P["⚡ Preprocess\n(JoinSet)"]
            P1["Worker 1"]
            P2["Worker 2"]
            P3["..."]
            P1 ~~~ P2 ~~~ P3
        end
        
        subgraph S["🔥 Session Pool"]
            S1["Session 1"]
            S2["Session 2"]
            S3["..."]
            S1 ~~~ S2 ~~~ S3
        end
        
        subgraph PP["⚡ Postprocess\n(JoinSet)"]
            PP1["Worker 1"]
            PP2["Worker 2"]
            PP3["..."]
            PP1 ~~~ PP2 ~~~ PP3
        end
        
        Batcher -->|"dispatch"| P
        P -->|"batch()"| S
        S -->|"slice"| PP
    end
    
    PP -->|"oneshot channel"| Responses["📤 Responses"]

    style INSIDE fill:#f5f5f5,stroke:#333,stroke-width:2px
    style Requests fill:#e3f2fd
    style Responses fill:#e3f2fd
    style Batcher fill:#fff3e0
    style P fill:#e8f5e9
    style S fill:#fce4ec
    style PP fill:#e8f5e9